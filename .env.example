# Ключи нужны только для внешних вызовов. Значения сюда не коммитим —
# скопируйте файл в .env (это сделает `python3 strateg.py setup`) и заполните.
# DEEPSEEK_API_KEY — доступ к OpenAI-совместимому API DeepSeek: задачи
#   extract_facts, tag_claims, synthetic_persona (см. config/routing.json).
DEEPSEEK_API_KEY=
# TYPESAFE_API_KEY — ключ TypeSafe для модели Jev (быстрая классификация и оценка
#   вариантов). Сейчас не используется: Jev не подключён, место под него —
#   в config/routing.json. Оставьте пустым.
TYPESAFE_API_KEY=
