{
  "providers": {
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "key_env": "DEEPSEEK_API_KEY"
    }
  },
  "tasks": {
    "extract_facts": {
      "executor": "helper",
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": "head"
    },
    "tag_claims": {
      "executor": "helper",
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": "head"
    },
    "synthetic_persona": {
      "executor": "helper",
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": "head"
    },
    "classify_request": {
      "executor": "head"
    },
    "research": {
      "executor": "head"
    },
    "options": {
      "executor": "head"
    },
    "strategy": {
      "executor": "head"
    },
    "critic": {
      "executor": "head"
    }
  },
  "_note": "helper — вспомогательная модель через tools/llm.py, head — головная модель среды. Если ключа нет или ответ не прошёл проверку, задачу делает головная модель. Имя модели DeepSeek — с официальной страницы цен, проверено 2026-11-05."
}